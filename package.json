{
  "name": "craft-audit",
  "version": "1.0.0",
  "description": "Comprehensive audit tool for Craft CMS projects — template analysis, security scanning, HTTP headers, CVE detection, system checks, and visual regression",
  "main": "dist/cli.js",
  "bin": {
    "craft-audit": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "data/",
    "php/analyze-templates.php",
    "craft-audit.config.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:watch": "npm run build && node --test --watch tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm test",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "craft-cms",
    "audit",
    "security",
    "twig",
    "performance",
    "visual-regression",
    "n+1",
    "eager-loading",
    "sarif",
    "cve",
    "http-headers",
    "cli"
  ],
  "author": "forbiddenlink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forbiddenlink/craft-audit.git"
  },
  "bugs": {
    "url": "https://github.com/forbiddenlink/craft-audit/issues"
  },
  "homepage": "https://github.com/forbiddenlink/craft-audit#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "minimatch": "^10.2.1",
    "next-safe-action": "^8.5.3",
    "ora": "^5.4.1",
    "pino": "^10.3.1"
  },
  "optionalDependencies": {
    "backstopjs": "^6.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/sarif": "^2.1.7",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "comment:overrides": "Pin transitive deps: minimatch for CVE-2024-XXXXX, lodash for CVE-2026-4800/CVE-2026-2950 (both via backstopjs)",
  "private": false,
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1",
      "next": ">=16.2.6",
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0",
      "lodash": ">=4.18.1",
      "fast-uri": ">=3.1.2",
      "uuid": ">=11.1.1"
    }
  }
}

{
  "name": "craft-audit",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.0",
  "description": "Comprehensive audit tool for Craft CMS projects — template analysis, security scanning, HTTP headers, CVE detection, system checks, and visual regression",
  "main": "dist/cli.js",
  "bin": {
    "craft-audit": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "data/",
    "php/analyze-templates.php",
    "craft-audit.config.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "test:watch": "pnpm run build && node --test --watch tests/*.test.cjs",
    "prepublishOnly": "pnpm run build && pnpm test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high",
    "lint-baseline": "biome check .",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "craft-cms",
    "audit",
    "security",
    "twig",
    "performance",
    "visual-regression",
    "n+1",
    "eager-loading",
    "sarif",
    "cve",
    "http-headers",
    "cli"
  ],
  "author": "forbiddenlink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forbiddenlink/craft-audit.git"
  },
  "bugs": {
    "url": "https://github.com/forbiddenlink/craft-audit/issues"
  },
  "homepage": "https://github.com/forbiddenlink/craft-audit#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "next-safe-action": "^8.6.1",
    "ora": "^9.4.1",
    "pino": "^10.3.1"
  },
  "optionalDependencies": {
    "backstopjs": "^6.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/sarif": "^2.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "private": false
}
